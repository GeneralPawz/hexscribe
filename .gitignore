# Node
node_modules/
dist/
*.tsbuildinfo

# Python
py/.venv/
__pycache__/
*.pyc
.pytest_cache/

# Model assets and downloads (multi-GB, fetched on demand)
models/
.cache/

# Local audio / outputs
tmp/
out/
*.local.yml

# The voice library. Speaker embeddings identify specific people by their voice,
# which makes this the most sensitive file the app writes -- more so than a
# transcript, because it is the thing that recognises someone in a recording
# they are not expecting to be in. It stays on the machine that made it.
voices.json

# Screenshots dropped into the fixtures folder while working. The oracle
# transcript beside the recordings is text and is committed; images are scratch.
test/fixtures/*.png

# Audio never belongs in this repo. Test recordings are private and live outside
# it (see HEXSCRIBE_TEST_AUDIO in py/tests/local_audio.py); this is the backstop
# in case one is ever copied in by accident.
*.wav
*.mp3
*.m4a
*.ogg
*.opus
*.flac
*.webm
*.mp4
